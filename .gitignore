# OS
.DS_Store
Thumbs.db

# Credentials (keep secure!) — all stored under config/
# NEVER commit these — they grant full access to user accounts
config/credentials.json
config/token.json
config/drive_token.json
config/calendar_token.json
config/settings.json

# ── Legacy runtime data (user-specific, potentially sensitive) ───────────────
# Older installs may still have state under data/.
# Canonical generated artifacts and selected runtime state now live under your_data/.
data/

# ── Generated user artifacts (workspace-local outputs) ────────────────────────
# All user-facing artifacts now default to your_data/ for cross-platform behavior.
# Keep the folder README committed, but ignore generated contents.
your_data/*
!your_data/README.md

# Agent registry & runtime state (machine-specific, may contain tokens)
agents.json
running_agents.json
running_tg_pollers.json

# ── Personal Assistant memory (private user context) ──────────────────────────
memory/

# Model Cache
model_cache/

# Logs
*.log
logs/

# ── Misc ──────────────────────────────────────────────────────────────────────
replacements.txt

# Ignore local error notes generated during development
errors/errors.txt
errors/new_implementation.txt


